# ==============================================================================
# GOD4XE GAMING & ESPORTS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Python Version for Render (Pins environment to Python 3.11.10)
PYTHON_VERSION=3.11.10

# Application secret key for session encryption & JWT token signing
SECRET_KEY=replace_with_a_secure_random_string_in_production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_EXPIRATION_DAYS=30

# Base URL of your deployed application (no trailing slash)
APP_URL=https://your-gaming-portal.onrender.com

# PostgreSQL Connection String (Provided by Render PostgreSQL)
# Format: postgresql://username:password@dpg-xxxxxx-a.oregon-postgres.render.com/dbname
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Environment mode: production or development
ENVIRONMENT=production

# Server Port (Render dynamically assigns $PORT; defaults to 8000 locally)
PORT=8000

# Initial admin setup for Render Free tier deployment
# On initial boot, if no admin exists, the server securely provisions this Super Admin.
ADMIN_USERNAME=admin_god4xe
ADMIN_PASSWORD=ChangeMeNow123!

# Google OAuth2 Client ID for Android & Web Google Sign-In
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Zero-Cost SMS / Mobile OTP Provider:
# "mock" = Zero-cost console & automated testing driver (no external SMS fees)
# "webhook" = Outbound HTTP webhook for custom gateway or production DLT gateway
SMS_PROVIDER=mock

# Legal & Regulatory Safety Guardrail for Real-Money Gaming Compliance
# Keep strictly set to "false" until applicable state, central, and payment licenses are verified.
WITHDRAWALS_ENABLED=false

# AdSense Client ID (configured via Admin Panel after AdSense approval)
ADSENSE_CLIENT_ID=
